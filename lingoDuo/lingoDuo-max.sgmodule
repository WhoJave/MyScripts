#!name=Duolingo Max 解锁
#!desc=解锁 Duolingo 会员（Max/Super 全部权益：无限体力、去广告、视频通话等），可选经验加倍、解锁全部关卡
#!author=Takagivegeta (Surge 版 by WhoJave)
#!homepage=https://github.com/WhoJave/MyScripts/tree/main/lingoDuo

[MITM]
hostname = %APPEND% ios-api-*.duolingo.com, ios-api-*.duolingo.cn, api*.duolingo.com, api*.duolingo.cn

[Script]
duolingo_max = type=http-response,pattern=^https?:\/\/(ios-api-[a-z0-9-]+|api\d+)\.duolingo\.c(n|om)\/2023-05-23\/(batch|users\/[^\/?#]+)(?:[?#]|$),script-path=https://raw.githubusercontent.com/WhoJave/MyScripts/main/lingoDuo/lingoDuo-max.js,requires-body=1,max-size=31457280,timeout=120,argument=member=max&xp_boost=false&multiplier=2&unlock_all=false&expires_days=365,script-update-interval=1440
